# Copiá este archivo a .env.local y completá los valores reales.
# .env.local NUNCA se sube a git.

# Base de datos Postgres en Supabase.
# Supabase > Project Settings > Database > Connection string > "Transaction pooler"
# (puerto 6543). Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=""

# Supabase Storage (adjuntos de los tickets).
# Supabase > Project Settings > API: "Project URL" y la clave "service_role"
# (secreta: solo se usa en el servidor, nunca con prefijo NEXT_PUBLIC_).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Opcional: nombre del bucket (por defecto "attachments", lo crea la migración).
SUPABASE_STORAGE_BUCKET=

# Correo saliente (SMTP). Sin estas variables, los avisos solo se registran en
# la consola. Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu
# Gmail y SMTP_PASS una "contraseña de aplicación" de 16 letras (requiere la
# verificación en dos pasos de Google), NO tu contraseña normal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional: remitente visible (por defecto "SYNEXA Soporte <SMTP_USER>").
# Con Gmail debe ser la misma dirección de SMTP_USER.
MAIL_FROM=
# Opcional: a quién llegan los avisos de tickets nuevos (por defecto ADMIN_EMAIL).
ADMIN_NOTIFY_EMAIL=

# Portal de Clientes (login, tickets, panel). Por defecto está habilitado.
# Poner "false" para ocultarlo: desaparecen los enlaces al portal y /login
# muestra un aviso de "próximamente".
PORTAL_ENABLED=true

# Auth.js (NextAuth v5) — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Login con Google (Google Cloud Console > Credenciales > ID de cliente de OAuth > Aplicación web)
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Administrador principal. Se crea automáticamente la primera vez que arranca
# el servidor, usando este correo y esta contraseña. Sin ADMIN_EMAIL no se crea
# ninguna cuenta de administrador.
ADMIN_EMAIL=
ADMIN_PASSWORD=CAMBIAR_PASSWORD

# Opcionales: nombre que tendrá esa cuenta (por defecto "Administrador").
ADMIN_NAME=
ADMIN_LAST_NAME=

# Opcional: solo para "npm run seed" (datos de prueba). Contraseña que tendrán
# los clientes ficticios de ejemplo. No completar en producción.
SEED_CLIENT_PASSWORD=
