# Copiá este archivo a .env.local y completá los valores reales.
# .env.local NUNCA se sube a git.

# Ruta del archivo SQLite local
DATABASE_PATH="./data/ticketera.db"

# Portal de Clientes (login, tickets, panel). Por defecto está habilitado.
# En un despliegue sin base de datos —como el sitio público en Netlify—
# poner "false": oculta los enlaces al portal y /login muestra un aviso.
PORTAL_ENABLED=true

# Auth.js (NextAuth v5) — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Login con Google (Google Cloud Console > Credenciales > ID de cliente de OAuth > Aplicación web)
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Administrador principal. Se crea automáticamente la primera vez que arranca
# el servidor, usando este correo y esta contraseña. Sin ADMIN_EMAIL no se crea
# ninguna cuenta de administrador.
ADMIN_EMAIL=
ADMIN_PASSWORD=CAMBIAR_PASSWORD

# Opcionales: nombre que tendrá esa cuenta (por defecto "Administrador").
ADMIN_NAME=
ADMIN_LAST_NAME=

# Opcional: solo para "npm run seed" (datos de prueba). Contraseña que tendrán
# los clientes ficticios de ejemplo. No completar en producción.
SEED_CLIENT_PASSWORD=
